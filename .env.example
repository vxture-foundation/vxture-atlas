# .env.example for atlas - authoritative reference for every supported
# variable. Copy to .env and fill in. .env is git-ignored and never committed.
# Convention: values below are the prod defaults; a "BETA OVERRIDES" note marks
# any key whose beta value differs. Secret keys are present-but-empty with a
# procurement note; real values are injected via env, never committed.
#
# SKELETON: this file, the production operator env (/srv/md0/atlas/etc/.env)
# and runos's counterpart all share the SAME section order and key order.
# Drift between them is a bug. The only cross-product difference is the
# atlas-specific provider-key vault section.
#
# Variable names are exact: the app reads these keys and no aliases - a
# misspelled or invented key is silently dead configuration.
#
# services profile (product_240 section 2.5), not app profile: no Next.js, no
# portals/, no browser session. The C1 OIDC RP block below is RIGID ZONE per
# the template but currently UNUSED - Atlas has no end-user browser surface
# today (the operator UI stays in vxture-platform's admin/console, calling
# Atlas over the network). Keep the block present and inert rather than
# omitted, per product_240's no-selective-skip rule for the rigid zone; wire it
# only if/when Atlas gets its own browser-facing surface.

# --- Runtime ---
NODE_ENV=production
APP_PUBLISH_PORT=3100                    # see docs/50-deployment/00-index.md
DEPLOY_STAGE=production                  # 025 identity block: deployment-injected (env_file overrides the image-baked value, so dev stacks report dev, not the CI build's stage). local dev: dev

# --- Host image pin (operational fallback; the CI deploy path overrides all of it) ---
# deploy.sh resolves the image as: explicit env > these two keys > defaults,
# and the TAG from the VERSION file the last deploy wrote (sha-<short>) - so a
# bare `deploy.sh start` on the host targets the currently-deployed image.
# IMAGE_TAG deliberately does NOT live here: VERSION is its always-fresh authority.
IMAGE_REGISTRY=                          # prod worker-02: the ACR registry host (ADR-005 primary); empty -> ghcr.io
IMAGE_NAMESPACE=                         # prod worker-02: vx-foundation; empty -> vxture

# --- Database (own physical DB; name per runos ADR-007) ---
# Atlas owns a fully separate PHYSICAL database, not a schema in the shared
# platform DB and not a vxturebiz_atlas_{env}-style business-plane DB either -
# see docs/30-design/00-index.md for why. The container superuser is the DB
# OWNER (POSTGRES_DB_OWNER, compose default `postgres`); the app connects as
# the least-privilege atlas_svc role via DATABASE_URL, never owner-direct.
POSTGRES_DB=vx_atlas_db                  # derived as vx_<product_code>_db (runos ADR-007: engine segment dropped); compose defaults to this, so it only needs setting to override
POSTGRES_PASSWORD=                       # DB OWNER password (fresh-init only); procure: ATLAS_DB_SVC_PASSWORD is the svc-role one inside DATABASE_URL
DATABASE_URL=postgresql://atlas_svc:@db:5432/vx_atlas_db   # host segment = compose service alias `db`, stable across container renames

# --- C1 OIDC RP (rigid zone, currently UNUSED - see header note) ---
OIDC_ISSUER=https://accounts.vxture.com  # also anchors S2S/operator JWKS verification ({issuer}/oidc/jwks); local dev: http://localhost:3081
# OIDC_BACKCHANNEL_ISSUER=                 # network override for the JWKS fetch only ({base}/oidc/jwks); iss claim check still uses OIDC_ISSUER above. Unset in prod/beta (issuer origin is directly reachable). Docker Desktop local dev running this app as a container against a host-process IdP: http://host.docker.internal:3081 (localhost inside the container is the container itself, not the host)
OIDC_CLIENT_ID=atlas                     # BETA OVERRIDES: atlas-beta
OIDC_CLIENT_SECRET=                      # procure: platform-issued client secret
OIDC_REDIRECT_URI=https://atlas.vxture.com/auth/callback
OIDC_SCOPES=openid profile email phone
OIDC_POST_LOGOUT_REDIRECT_URI=https://atlas.vxture.com/
OIDC_RP_ENABLED=off                      # off until Atlas has a browser-facing surface to protect
RP_SESSION_TTL=2592000
RP_SESSION_COOKIE_NAME=__Host-vx_rp_session   # dev over http: vx_rp_session
# REDIS_URL=redis://vx-atlas-redis-db-prod:6379   # only once OIDC_RP_ENABLED=on; add the redis compose service at that point

# --- S2S inbound (product_210 token exchange - Atlas as callee) ---
# Verifies the RS256 S2S access token other products (BFF/varda) present when
# calling /v1/* or /capability/*. Reuses OIDC_ISSUER above for both `iss`
# match and JWKS lookup.
S2S_AUDIENCE=atlas                       # must equal the stable product_code used as `aud` in issued S2S tokens

# --- C2/C3 platform client (entitlement read + usage consume) ---
# PLATFORM_API_URL must be an INTERNAL (tailnet) base per the product_240
# S2S egress guard. Unset -> Mock
# resolver, no live entitlements; consume calls are skipped.
PLATFORM_API_URL=
PLATFORM_INTERNAL_AUTH_TOKEN=            # transitional; product_210 token exchange is the target state - counterpart of the platform's AUTH_INTERNAL_TOKEN

# --- C3 provisioning webhook (dual-secret rotation; NEXT = overlap slot) ---
PROVISION_WEBHOOK_SECRET=                # procure: ATLAS_PROVISION_WEBHOOK_SECRET (platform key)
PROVISION_WEBHOOK_SECRET_NEXT=           # optional, rotation overlap

# --- Provider-key vault (atlas-specific; envelope encryption, ADR-003) ---
# PROVIDER_KEY_ENCRYPTION_KEYS is a JSON map of master keys for the
# key.provider_api_keys vault: {"<key_id>":"<base64 32B>", ...}.
# PROVIDER_KEY_ENCRYPTION_ACTIVE_KEY_ID names the entry that encrypts new
# writes; every entry in the map stays available for decryption.
# Legacy per-provider `apiKeyEnvVar` keys live in the SEPARATE
# .env.provider-keys file (second compose env_file, chmod 400, never
# CI-bootstrapped) - see .env.provider-keys.example.
PROVIDER_KEY_ENCRYPTION_KEYS=            # procure: generate 32-byte key, base64
PROVIDER_KEY_ENCRYPTION_ACTIVE_KEY_ID=

# --- Internal diagnostics guard (/status /metrics /internal/*) ---
# Admission: ALLOW_INTERNAL_DIAGNOSTICS=1 (local-dev override - never set in
# production), OR a loopback source address, OR a timing-safe match on
# INTERNAL_DIAGNOSTICS_TOKEN. INTERNAL_DIAGNOSTICS_ALLOW_IPS is a NARROWING on
# top of the token (when set, the token only works from those addresses), not
# an admission path of its own - a source IP is a property of the network, not
# a credential the caller presents. The x-internal-call header is a plaintext
# marker and NOT an authentication factor. With no token set, every
# non-loopback caller is DENIED.
ALLOW_INTERNAL_DIAGNOSTICS=
INTERNAL_DIAGNOSTICS_TOKEN=
INTERNAL_DIAGNOSTICS_ALLOW_IPS=          # comma-separated operator IPs (tailnet)

# --- Upstream provider calls (optional tuning) ---
# Time-to-first-byte budget for any call Atlas makes to a model provider: if
# the upstream has not sent response headers within this window, the request
# is aborted rather than left in flight. Deliberately NOT a total timeout - a
# long generation is normal and must not be killed mid-stream. Default 30000.
# PROVIDER_CONNECT_TIMEOUT_MS=30000
