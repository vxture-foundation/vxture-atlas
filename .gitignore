# Environment - never commit real secrets
.env
*.env
.env.*
!.env.example
!.env.local.example
!.env.provider-keys.example
!deploy/env/*.env
.env.bak.*
.npmrc
# The .npmrc only declares the @vxture GitHub Packages registry and references
# ${NODE_AUTH_TOKEN} (no literal secret). It MUST stay committed so CI
# `pnpm install` can resolve @vxture/* packages. Ignored-then-negated to guard
# against a local `npm login` writing a literal token into it.
!.npmrc

# Runtime data and generated configs (repo-root only - do not let this
# shadow source dirs like service/src/runtime/ or service/src/generated/)
/data/
/backup/
/private/
/runtime/
/generated/

# TLS / certificates
*.pem
*.key
*.crt
*.csr
*.p12
*.pfx

# Logs
*.log
logs/

# Node / pnpm / build output (services profile: no Next.js, no .next/out)
node_modules/
.pnpm-store/
.npm-cache/
dist/
build/
*.tsbuildinfo

# Prisma generated client (regenerated by `pnpm db:generate`, not committed).
# Leading-slash-free but slash-containing patterns anchor to this file's own
# directory, so a bare `src/generated/` matched only <root>/src/generated - not
# the real path, service/src/generated. `**/` anchors it anywhere instead.
**/src/generated/

# Test / coverage
coverage/
.nyc_output/

# OS / editor
.DS_Store
.vscode/
.idea/
*.swp
*.swo

.claude/

# Python bytecode (local compileall artifacts)
__pycache__/
*.pyc

# Scratch staging for pre-formalized design drafts. Anything that survives
# review moves into docs/ under a number; nothing here is repo history.
temp/

# Prisma client generated into the source tree (schema.prisma `output`).
# CI regenerates it in both the build and test-coverage jobs (`db:generate`),
# so it is a build artifact, not source - and at ~29k lines it would drown
# every diff that ran `git add -A` from the repo root.
service/src/generated/
.tmp-doc/

# Local credential drop-box. Never committed - this repo is public, and a key
# that reaches history is revoked at the source console, not scrubbed out.
# Ignored as a DIRECTORY: `*.key` does not match `.api-key`, and the first
# version of this landed as an untracked directory that `git add -A` would
# have swept in whole.
.api-key/

# Same drop-box, single-file form. Named explicitly for the reason the comment
# above already gives: `*.key` matches a file ENDING in `.key`, and
# `.deepseek-api-key` ends in `-key`, so it was untracked-but-not-ignored -
# one `git add -A` away from history. Add a line here per provider rather than
# widening the glob; a pattern loose enough to catch these would also catch
# real source files.
.deepseek-api-key
*-api-key

# Published-artifact sources (the rendered docs live on claude.ai; these are
# the authoring copies, kept out of the repo so the doc set has one home).
.artifacts/
.doc-skeletons.txt
.errorcodes.txt
.routes.json

# Any scratch file a local verification step writes into the repo root.
#
# This is not hypothetical tidiness. `.devenv.tmp` - one `docker inspect` dump
# of the dev app container's environment, written here because the session
# scratchpad was unusable - was swept into a commit by `git add -A` and pushed
# to this PUBLIC repo on 2026-08-17. It carried the vault master key set
# (PROVIDER_KEY_ENCRYPTION_KEYS), a live DOUBAO_API_KEY, the C3 provisioning
# webhook secret and the dev database password.
#
# Deleting the branch did not undo it: GitHub keeps refs/pull/<n>/head, so the
# commit stayed fetchable. Rotation at the source console is the only remedy -
# which is exactly what this repo's secret-hygiene rule already said.
#
# So: never write container environment into the working tree. If a scratch
# file is unavoidable, it lands on one of these patterns and git cannot see it.
*.tmp
*.env.dump
.devenv*
