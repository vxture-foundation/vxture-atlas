# Scope -> registry mapping only. The credential does NOT live here: pnpm 11
# ignores env-expanded auth in a committed project .npmrc (secret-leak
# hardening). Each environment provides it at user level instead:
#   local  : pnpm config set //npm.pkg.github.com/:_authToken <PAT read:packages>
#   CI     : install steps append it to the runner's ~/.npmrc (ci.yml)
#   docker : deps stage writes it from the node_auth_token BuildKit secret
@vxture:registry=https://npm.pkg.github.com
