{
  "name": "@atlas/service",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Atlas - model registry, routing, quota and metering",
  "scripts": {
    "build": "esbuild src/main.ts --bundle --platform=node --format=cjs --target=node24 --outfile=dist/main.cjs --tsconfig=tsconfig.json --external:@nestjs/websockets/socket-module --external:@nestjs/microservices --external:@nestjs/microservices/microservices-module --external:@prisma/client --external:class-transformer --external:class-validator",
    "dev": "pnpm run build && node dist/main.cjs",
    "start": "node dist/main.cjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "type-check": "tsc --noEmit",
    "lint": "eslint src",
    "lint:fix": "eslint --fix src",
    "db:generate": "prisma generate --schema prisma/schema.prisma"
  },
  "dependencies": {
    "@nestjs/common": "^11.0.0",
    "@nestjs/core": "^11.1.28",
    "@nestjs/platform-express": "^11.0.0",
    "@prisma/adapter-pg": "^7.9.1",
    "@prisma/client": "^7.9.1",
    "@prisma/client-runtime-utils": "^7.9.1",
    "@vxture/shared": "^1.5.0",
    "eventsource-parser": "3.1.0",
    "jose": "^6.2.4",
    "prom-client": "^15.1.3",
    "reflect-metadata": "^0.2.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^24.0.0",
    "@typescript-eslint/eslint-plugin": "^8.66.0",
    "@typescript-eslint/parser": "^8.66.0",
    "@vitest/coverage-v8": "^4.1.8",
    "esbuild": "^0.28.1",
    "eslint": "^10.8.0",
    "prisma": "^7.9.1",
    "typescript": "^6.0.3",
    "vitest": "^4.1.8"
  },
  "engines": {
    "node": ">=24.0.0"
  }
}
